%% Wonton POS - Final BRD v3 Use Case Diagram (26 UC) - Mermaid edition.

flowchart LR

%% ====================== ACTORS (left column) ======================
  subgraph Actors_Client["👤 Customer Actors"]
    direction TB
    Customer(["Customer<br/>(Guest / Registered)"])
    Registered(["Registered<br/>Customer"])
    Registered -.->|is a| Customer
  end

%% ====================== SYSTEM BOUNDARY ===========================
  subgraph System["Wonton POS"]
    direction LR

    %% ---------- Client WebApp ----------
    subgraph ClientPkg["Client WebApp - Customer Facing"]
      direction TB
      UC25("Manage Customer Account<br/>and Authentication")
      UC01("Place Online Order")
      UC03("Schedule Pickup Order")
      UC26("Complete Checkout<br/>and Apply Promotion")
      UC02("Online Payment")
      UC04("View Order History")
      UC17("Reorder Past Order")
      UC11("Track Order")
      UC16("Receive Order<br/>Notifications")
      UC15("Rate Order")
    end

    %% ---------- Admin - Manager Control ----------
    subgraph ManagerPkg["Admin WebApp - Manager Control"]
      direction TB
      UC19("View Operational<br/>Dashboard")
      UC07("View Revenue Statistics")
      UC05("Manage Menu")
      UC08("Manage Tables")
      UC06("Manage Staff")
      UC18("Manage Promotions")
      UC21("Close Shift and<br/>Reconcile End-of-day")
    end

    %% ---------- Admin - FOH Operations ----------
    subgraph FOHPkg["Admin WebApp - FOH Operations"]
      direction TB
      UC09("Create In-Store Order")
      UC12("Assign Order to Table")
      UC10("Process Payment")
      UC20("Manage Active Orders")
      UC23("Serve and<br/>Confirm Handoff")
      UC24("Handle Complaint and<br/>Operational Exception")
    end

    %% ---------- Admin - BOH Operations ----------
    subgraph BOHPkg["Admin WebApp - BOH Operations"]
      direction TB
      UC13("Receive Kitchen Orders")
      UC14("Update Dish Status")
      UC22("Mark Menu Item as 86'd")
    end
  end

%% ====================== ACTORS (right column) =====================
  subgraph Actors_Admin["👥 Staff Actors"]
    direction TB
    Manager(["Manager"])
    FOHStaff(["FOH Staff"])
    Cashier(["Cashier"])
    ServiceStaff(["Service Staff<br/>(Waiter)"])
    Cashier -.->|is a| FOHStaff
    ServiceStaff -.->|is a| FOHStaff
    BOHStaff(["BOH Staff<br/>(Kitchen)"])
  end

