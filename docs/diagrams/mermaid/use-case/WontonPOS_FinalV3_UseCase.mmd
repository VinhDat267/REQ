  Manager --- UC21
  Manager --- UC20
  Manager --- UC22
  Manager --- UC24

  %% FOH Staff (Cashier + Server roles)
  FOHStaff --- UC09
  FOHStaff --- UC12
  FOHStaff --- UC20
  FOHStaff --- UC24

  %% Cashier-specific FOH responsibilities
  Cashier --- UC10
  Cashier --- UC21
  Cashier --- UC23

  %% Service Staff / Waiter-specific FOH responsibilities
  ServiceStaff --- UC23

  %% BOH Staff (Kitchen)
