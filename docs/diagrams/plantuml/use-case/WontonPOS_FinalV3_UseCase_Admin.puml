@startuml WontonPOS_FinalV3_UseCase_Admin
' =====================================================================
' Wonton POS - Final BRD v3 Use Case Diagram (Admin WebApp, 16 UC)
' =====================================================================
' Scope  : Admin-side use cases only (UC-05, 06, 07, 08, 09, 10, 12,
'          13, 14, 18, 19, 20, 21, 22, 23, 24).
' Actors : Manager, FOH Staff, Cashier, Service Staff (Waiter), BOH Staff (Kitchen).
' Notes  : UC nodes display the title only (no UC-xx prefix).
'          Include/Extend follow UML 2.5 semantics:
'            - A ..> B : <<include>>  -> A always requires B
'            - A ..> B : <<extend>>   -> A is optional add-on to B
' Pair   : WontonPOS_FinalV3_UseCase_Client.puml
' =====================================================================

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam nodesep 22
skinparam ranksep 55
skinparam roundcorner 6
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor     #37474F
  FontColor       #37474F
}

skinparam usecase {
  BackgroundColor #F8F9FA
  BorderColor     #37474F
  ArrowColor      #455A64
  FontColor       #263238
}

skinparam package {
  BackgroundColor<<ManagerPkg>> #FFF3E0
  BorderColor<<ManagerPkg>>     #E65100
  BackgroundColor<<FOHPkg>>     #E8F5E9
  BorderColor<<FOHPkg>>         #2E7D32
  BackgroundColor<<BOHPkg>>     #FCE4EC
  BorderColor<<BOHPkg>>         #AD1457
  FontSize                      13
  FontStyle                     bold
}

skinparam rectangle {
  BorderColor #455A64
  FontSize    14
  FontStyle   bold
}

title Wonton POS - Admin WebApp Use Case Diagram\n<size:11>16 UC for Manager, FOH / Cashier / Service Staff, BOH Staff (multi-role staffing allowed).</size>


' ---------- Actors ----------------------------------------------------
actor "Manager"                        as Manager
actor "FOH Staff"                      as FOHStaff
actor "Cashier"                        as Cashier
actor "Service Staff\n(Waiter)"        as ServiceStaff
actor "BOH Staff\n(Kitchen)"           as BOHStaff

Cashier --|> FOHStaff
ServiceStaff --|> FOHStaff


' ---------- System boundary ------------------------------------------
rectangle "Wonton POS - Admin WebApp" {

  package "Manager Control" <<ManagerPkg>> {
    usecase "View Operational Dashboard"                  as UC19
    usecase "View Revenue Statistics"                     as UC07
    usecase "Manage Menu"                                 as UC05
    usecase "Manage Tables"                               as UC08
    usecase "Manage Staff"                                as UC06
    usecase "Manage Promotions"                           as UC18
    usecase "Close Shift and\nReconcile End-of-day"       as UC21
  }

  package "FOH Operations" <<FOHPkg>> {
    usecase "Create In-Store Order"                       as UC09
    usecase "Assign Order to Table"                       as UC12
    usecase "Process Payment"                             as UC10
    usecase "Manage Active Orders"                        as UC20
    usecase "Serve and Confirm Handoff"                   as UC23
    usecase "Handle Complaint and\nOperational Exception" as UC24
  }

  package "BOH Operations" <<BOHPkg>> {
    usecase "Receive Kitchen Orders"                      as UC13
    usecase "Update Dish Status"                          as UC14
    usecase "Mark Menu Item as 86'd"                      as UC22
  }
}


' ---------- Actor associations ---------------------------------------

' Manager (owns all Manager Control + co-owner on several operational UCs)
Manager -- UC19
Manager -- UC07
Manager -- UC05
Manager -- UC08
Manager -- UC06
Manager -- UC18
Manager -- UC21
Manager -- UC20
Manager -- UC22
Manager -- UC24

' FOH Staff
FOHStaff -- UC09
FOHStaff -- UC12
FOHStaff -- UC20
FOHStaff -- UC24

' Cashier-specific FOH responsibilities
Cashier -- UC10
Cashier -- UC21
Cashier -- UC23

' Service Staff / Waiter-specific FOH responsibilities
ServiceStaff -- UC23

' BOH Staff
BOHStaff -- UC13
BOHStaff -- UC14
BOHStaff -- UC22


' ---------- Extend (extension -> base) -------------------------------
UC12 ..> UC09 : <<extend>>
UC10 ..> UC09 : <<extend>>
UC22 ..> UC14 : <<extend>>
UC24 ..> UC20 : <<extend>>
UC24 ..> UC22 : <<extend>>
UC24 ..> UC23 : <<extend>>


' ---------- Layout hints ---------------------------------------------
UC19 -[hidden]down- UC07
UC07 -[hidden]down- UC05
UC05 -[hidden]down- UC08
UC08 -[hidden]down- UC06
UC06 -[hidden]down- UC18
UC18 -[hidden]down- UC21

UC09 -[hidden]down- UC12
UC12 -[hidden]down- UC10
UC10 -[hidden]down- UC20
UC20 -[hidden]down- UC23
UC23 -[hidden]down- UC24

UC13 -[hidden]down- UC14
UC14 -[hidden]down- UC22


' ---------- Notes ----------------------------------------------------
note top of UC21
End-of-day reconciliation aggregates
cash (UC-10), online payments, refunds,
Comp, Forfeited, and Write-off buckets,
and hands over unresolved exceptions to
the next shift.
end note

note bottom of UC22
86'd is independent from inventory stock
adjustment (§3m). Paid orders containing
a now-86'd item are flagged and escalated
to Handle Complaint for Manager action.
end note

note right of UC24
Resolutions include remake, substitution,
partial refund, full refund, Comp, or
Write-off; refund / Comp / Write-off
require Manager approval with audit log.
end note

@enduml
