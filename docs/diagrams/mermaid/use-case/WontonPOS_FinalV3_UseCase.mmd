  classDef manager fill:#FFF3E0,stroke:#E65100,stroke-width:1px,color:#BF360C
  classDef foh fill:#E8F5E9,stroke:#2E7D32,stroke-width:1px,color:#1B5E20
  classDef boh fill:#FCE4EC,stroke:#AD1457,stroke-width:1px,color:#880E4F

  class Customer,Registered,Manager,FOHStaff,Cashier,ServiceStaff,BOHStaff actor
  class UC01,UC02,UC03,UC04,UC11,UC15,UC16,UC17,UC25,UC26 client
